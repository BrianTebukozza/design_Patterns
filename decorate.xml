// ==========================================
// MAMA BETTY'S ROLEX STAND - DECORATOR PATTERN
// ==========================================

// 1. THE INTERFACE (The Contract)
// ------------------------------------------
INTERFACE Rolex:
    METHOD getDescription() RETURNS String
    METHOD getCost() RETURNS Number


// 2. THE CONCRETE COMPONENT (The Base Item)
// ------------------------------------------
CLASS PlainRolex IMPLEMENTS Rolex:
    METHOD getDescription():
        RETURN "Standard Rolex (1 Egg, 1 Chapati)"

    METHOD getCost():
        RETURN 2000 // Base Price in UGX


// 3. THE BASE DECORATOR (The Wrapper Template)
// ------------------------------------------
ABSTRACT CLASS RolexDecorator IMPLEMENTS Rolex:
    ATTRIBUTE wrappedRolex: Rolex // This holds the inner object

    CONSTRUCTOR(innerRolex):
        SET wrappedRolex = innerRolex

    METHOD getDescription():
        // Default: just ask the inner item for its description
        RETURN wrappedRolex.getDescription()

    METHOD getCost():
        // Default: just ask the inner item for its cost
        RETURN wrappedRolex.getCost()


// 4. CONCRETE DECORATORS (The Add-ons)
// ------------------------------------------

CLASS ExtraEgg EXTENDS RolexDecorator:
    METHOD getDescription():
        RETURN SUPER.getDescription() + ", + Extra Egg"

    METHOD getCost():
        RETURN SUPER.getCost() + 500

CLASS VeggieMix EXTENDS RolexDecorator:
    METHOD getDescription():
        RETURN SUPER.getDescription() + ", with Veggie Mix"

    METHOD getCost():
        RETURN SUPER.getCost() + 300

CLASS StudentDiscount EXTENDS RolexDecorator:
    METHOD getDescription():
        RETURN "PROMO: " + SUPER.getDescription()

    METHOD getCost():
        RETURN SUPER.getCost() - 200


// 5. EXECUTION LOGIC (How Mama Betty builds it)
// ------------------------------------------
START PROGRAM:
    // Case 1: A "Premium" Rolex
    rolex1 = NEW PlainRolex()
    rolex1 = NEW ExtraEgg(rolex1)   // Wrapped once
    rolex1 = NEW ExtraEgg(rolex1)   // Wrapped twice (3 eggs total!)
    rolex1 = NEW VeggieMix(rolex1)  // Wrapped thrice

    PRINT("Order 1: " + rolex1.getDescription())
    PRINT("Total: " + rolex1.getCost() + " UGX")

    PRINT("--------------------------------")

    // Case 2: A Student Special
    rolex2 = NEW PlainRolex()
    rolex2 = NEW VeggieMix(rolex2)
    rolex2 = NEW StudentDiscount(rolex2)

    PRINT("Order 2: " + rolex2.getDescription())
    PRINT("Total: " + rolex2.getCost() + " UGX")
END PROGRAM